# Sao chép thành .streamlit/secrets.toml rồi điền thông tin. KHÔNG commit file secrets.toml.

# "powerautomate" = qua flow Power Automate (docs/power_automate.md)
# "sharepoint"    = Microsoft Graph, cần đăng ký App trên Entra ID
# "local"         = file SQLite để chạy thử
BACKEND = "powerautomate"
NAM_HOC = "2024-2025,2025-2026,2026-2027,2027-2028"
NAM_HOC_MAC_DINH = "2026-2027"

# List "Data tuyển sinh" có sẵn (GUID lấy từ file .iqy) và list hồ sơ nhập học
SP_LIST_Data_TuyenSinh = "d0608833-bddf-4d28-a7db-402eb246c017"
SP_LIST_Data_NhapHoc = "Data_NhapHoc"

[powerautomate]
flow_url = "https://prod-xx.southeastasia.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?..."
key = "DAT-MAT-KHAU-RIENG-O-DAY"

# Chỉ dùng khi BACKEND = "sharepoint"
[sharepoint]
site_url = "https://eduttc.sharepoint.com/sites/tuyensinh2"
tenant_id = ""
client_id = ""
client_secret = ""

# (Tùy chọn) chỉ định tên nội bộ cột nếu app không tự khớp được theo tên hiển thị
# [field_map.Data_TuyenSinh]
# HoTenHS = "Ten_x0020_HS"

# (Tùy chọn) Bắt buộc đăng nhập bằng tài khoản Microsoft 365 của trường
# [auth]
# redirect_uri = "https://<dia-chi-app>/oauth2callback"
# cookie_secret = "chuoi-ngau-nhien-dai"
# client_id = "xxxxxxxx-..."
# client_secret = "..."
# server_metadata_url = "https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration"
